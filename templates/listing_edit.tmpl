{{define "content"}}
<div class="container py-4">
    <header class="edit-header">
        <h1>Editar Propiedad</h1>
        <p class="text-muted">Gestiona detalles y fotos para: <strong>{{.Listing.Title}}</strong></p>
    </header>

    <div class="edit-grid mt-4">
        <!-- Main Edit Form -->
        <div class="edit-main">
            <!-- Media Upload Workspace -->
            <section class="edit-section card p-4">
                <h2 class="section-title">Galería de Fotos</h2>
                <p class="text-muted font-sm">Sube fotos claras del terreno o construcción. JPG y PNG soportados.</p>
                
                <form method="POST" action="/api/upload/listing-photos?listing_id={{.Listing.ID}}" enctype="multipart/form-data" class="mt-3" novalidate>
                    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
                    <div class="form-group">
                        <input type="file" name="photos" multiple class="form-input" accept="image/*">
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm mt-2">Subir Fotos</button>
                </form>

                {{if .Listing.Media}}
                <div class="photo-management-grid mt-3">
                    {{range .Listing.Media}}
                    <div class="photo-manage-card">
                        <img src="{{.URL}}" alt="Foto de la propiedad" class="photo-manage-img">
                    </div>
                    {{end}}
                </div>
                {{end}}
            </section>
        </div>

        <!-- Sticky Publish Panel -->
        <aside class="edit-sidebar">
            <div class="card p-4">
                <h3>Estado de Publicación</h3>
                <p class="text-muted font-sm mt-1">Tu publicación está actualmente en estado: <strong>{{.Listing.Status}}</strong></p>
                
                <div class="sidebar-actions mt-3">
                    <a href="/propiedades/{{.Listing.Slug}}" class="btn btn-outline btn-block" target="_blank">Vista Previa</a>
                    
                    {{if eq .Listing.Status "draft"}}
                    <form method="POST" action="/propiedades/{{.Listing.Slug}}/publicar" class="mt-2">
                        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
                        <button type="submit" class="btn btn-primary btn-block">Publicar Ahora</button>
                    </form>
                    {{end}}

                    <form method="POST" action="/propiedades/{{.Listing.Slug}}/eliminar" class="mt-2" onsubmit="return confirm('¿Seguro que deseas eliminar esta propiedad? Esta acción no se puede deshacer.')">
                        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
                        <button type="submit" class="btn btn-danger btn-block">Eliminar Publicación</button>
                    </form>
                </div>
            </div>
        </aside>
    </div>
</div>
{{end}}
