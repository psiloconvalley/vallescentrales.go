{{define "content"}}
<div class="container py-4">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Navegación secundaria">
        <a href="/propiedades" class="breadcrumb-link">← Volver a Propiedades</a>
    </nav>

    <main class="listing-detail-grid mt-3">
        <!-- Left Column: Media & Information -->
        <article class="listing-main-content">
            <header class="listing-detail-header">
                <span class="badge badge-primary">{{.Listing.PropertyType}}</span>
                <h1 class="listing-title mt-1">{{.Listing.Title}}</h1>
                <p class="listing-location text-muted">
                    📍 {{.Listing.Municipality}}
                    {{if .Listing.Community}}• {{.Listing.Community}}{{end}}
                </p>
                <div class="listing-price-tag mt-2">
                    <span class="price-mxn">{{formatMXN .Listing.PriceMXN}}</span>
                    <span class="price-usd text-muted">({{formatUSD (convertToUSD .Listing.PriceMXN)}} USD)</span>
                </div>
            </header>

            <!-- Gallery -->
            <section class="listing-gallery mt-4">
                {{if .Listing.Media}}
                    <div class="gallery-viewport">
                        {{$primary := .Listing.PrimaryPhoto}}
                        <img id="activeGalleryImage" src="{{$primary.URL}}" alt="{{.Listing.Title}}" class="gallery-active-img">
                    </div>
                    {{if gt (len .Listing.Media) 1}}
                        <div class="gallery-thumbnails mt-2">
                            {{range .Listing.Media}}
                                <button type="button" class="gallery-thumb-btn" onclick="document.getElementById('activeGalleryImage').src='{{.URL}}'">
                                    <img src="{{.URL}}" alt="Miniatura de la propiedad" class="gallery-thumb-img">
                                </button>
                            {{end}}
                        </div>
                    {{end}}
                {{else}}
                    <div class="gallery-placeholder">
                        <span class="placeholder-icon">🏡</span>
                        <p>No hay fotos disponibles para esta propiedad</p>
                    </div>
                {{end}}
            </section>

            <!-- Specifications Grid -->
            <section class="listing-specs mt-4">
                <h2 class="section-title">Características principales</h2>
                <div class="specs-grid mt-2">
                    <div class="spec-card">
                        <span class="spec-label">Tipo de Propiedad</span>
                        <span class="spec-value">{{.Listing.PropertyType}}</span>
                    </div>
                    {{if .Listing.AreaM2}}
                    <div class="spec-card">
                        <span class="spec-label">Terreno (M²)</span>
                        <span class="spec-value">{{.Listing.AreaM2}} m²</span>
                    </div>
                    {{end}}
                    {{if .Listing.ConstructionM2}}
                    <div class="spec-card">
                        <span class="spec-label">Construcción (M²)</span>
                        <span class="spec-value">{{.Listing.ConstructionM2}} m²</span>
                    </div>
                    {{end}}
                    <div class="spec-card">
                        <span class="spec-label">Vistas</span>
                        <span class="spec-value">👁️ {{.Listing.ViewCount}}</span>
                    </div>
                </div>
            </section>

            <!-- Description -->
            {{if .Listing.Description}}
            <section class="listing-description mt-4">
                <h2 class="section-title">Descripción</h2>
                <div class="description-body mt-2">
                    <p>{{.Listing.Description}}</p>
                </div>
            </section>
            {{end}}
        </article>

        <!-- Right Column: Contact Card Widget (Securely Gated) -->
        <aside class="listing-sidebar">
            <div class="listing-contact">
                {{if .IsOwner}}
                    <h2>Esta es tu propiedad</h2>
                    <p class="text-muted">Puedes administrar esta publicación desde tu panel de control.</p>
                    <div class="owner-contact-actions mt-3">
                        <a href="/propiedades/{{.Listing.Slug}}/editar" class="btn btn-outline btn-block">Editar Publicación</a>
                    </div>
                {{else if .CanContact}}
                    <h2>¿Te interesa esta propiedad?</h2>
                    <p class="text-muted">Contacta directamente al propietario:</p>
                    <div class="contact-methods-grid mt-3">
                        <!-- Direct Email Connection -->
                        <a href="mailto:{{.Owner.Email}}?subject=Interés en propiedad: {{.Listing.Title}}" class="btn btn-outline btn-block">
                            ✉️ Contactar por Correo
                        </a>

                        <!-- Direct WhatsApp (Gated by Owner's Visibility preference & Value existence) -->
                        {{if and .Owner.ShowWhatsApp .Owner.WhatsApp}}
                            <a href="https://wa.me/{{.Owner.WhatsApp}}?text=Hola,%20me%20interesa%20la%20propiedad%20que%20publicaste:%20{{.Listing.Title}}" target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp btn-block mt-2">
                                📱 Contactar por WhatsApp
                            </a>
                        {{end}}

                        <!-- Phone Call Connection (Gated by Owner's Visibility preference & Value existence) -->
                        {{if and .Owner.ShowPhone .Owner.Phone}}
                            <a href="tel:{{.Owner.Phone}}" class="btn btn-outline btn-block mt-2">
                                📞 Llamar al Propietario
                            </a>
                        {{end}}
                    </div>
                {{else}}
                    <h2>¿Te interesa esta propiedad?</h2>
                    <p class="text-muted font-sm">Debes iniciar sesión para poder ver los datos de contacto del propietario.</p>
                    <div class="contact-auth-gates mt-3">
                        <a href="/login?redirect=/propiedades/{{.Listing.Slug}}" class="btn btn-primary btn-block">
                            Iniciar Sesión
                        </a>
                        <a href="/registro" class="btn btn-outline btn-block mt-2">
                            Crear una Cuenta
                        </a>
                    </div>
                {{end}}
            </div>
        </aside>
    </main>
</div>
{{end}}
