{{define "content"}}
<div class="listing-detail-page">
  <div class="container">
    <nav class="breadcrumb" aria-label="Navegación">
      <a href="/">Inicio</a>
      <span class="breadcrumb-sep">›</span>
      <a href="/propiedades">Propiedades</a>
      <span class="breadcrumb-sep">›</span>
      <span aria-current="page">{{.Listing.Title}}</span>
    </nav>

    <div class="listing-layout">
      <!-- Main Content -->
      <main class="listing-main">
        <header class="listing-header">
          <div class="listing-badges">
            <span class="listing-badge listing-badge-operation">{{operationLabel (printf "%s" .Listing.OperationType)}}</span>
            <span class="listing-badge listing-badge-type">{{propertyTypeLabel (printf "%s" .Listing.PropertyType)}}</span>
            {{if .Listing.IsFeatured}}
              <span class="listing-badge listing-badge-featured">Destacada</span>
            {{end}}
          </div>
          <h1 class="listing-title">{{.Listing.Title}}</h1>
          <p class="listing-location">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            {{if .Listing.Community}}{{derefString .Listing.Community}}, {{end}}{{.Listing.Municipality}}, Oaxaca
          </p>
        </header>

        <!-- Photo Gallery -->
        {{if .Listing.Media}}
          <div class="gallery">
            <div class="gallery-main">
              <img id="gallery-main-img" src="{{(index .Listing.Media 0).URL}}" alt="{{.Listing.Title}}" class="gallery-main-img" loading="eager">
            </div>
            {{if gt (len .Listing.Media) 1}}
              <div class="gallery-thumbs">
                {{range $i, $photo := .Listing.Media}}
                  <button type="button" class="gallery-thumb{{if eq $i 0}} is-active{{end}}" data-src="{{$photo.URL}}" aria-label="Foto {{add $i 1}}">
                    <img src="{{$photo.URL}}" alt="" loading="lazy">
                  </button>
                {{end}}
              </div>
            {{end}}
          </div>
        {{else}}
          <div class="gallery-empty">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
              <circle cx="8.5" cy="8.5" r="1.5"></circle>
              <polyline points="21 15 16 10 5 21"></polyline>
            </svg>
            <p>Sin fotografías disponibles</p>
          </div>
        {{end}}

        <!-- Mobile Price Card -->
        <div class="price-mobile">
          <div class="price-mobile-main">{{formatMXN .Listing.PriceMXN}}</div>
          <div class="price-mobile-sub">{{convertToUSD .Listing.PriceMXN}}</div>
        </div>

        <!-- Description -->
        <section class="listing-section">
          <h2 class="listing-section-title">Descripción</h2>
          <div class="listing-description">
            <p>{{derefString .Listing.Description}}</p>
          </div>
        </section>

        <!-- Specifications -->
        <section class="listing-section">
          <h2 class="listing-section-title">Características</h2>
          <div class="specs-grid">
            <div class="spec-item">
              <span class="spec-label">Operación</span>
              <span class="spec-value">{{operationLabel (printf "%s" .Listing.OperationType)}}</span>
            </div>
            <div class="spec-item">
              <span class="spec-label">Tipo</span>
              <span class="spec-value">{{propertyTypeLabel (printf "%s" .Listing.PropertyType)}}</span>
            </div>
            <div class="spec-item">
              <span class="spec-label">Régimen legal</span>
              <span class="spec-value">{{legalRegimeLabel (printf "%s" .Listing.LegalRegime)}}</span>
            </div>
            {{if .Listing.AreaM2}}
              <div class="spec-item">
                <span class="spec-label">Terreno</span>
                <span class="spec-value">{{formatNumber (derefFloat .Listing.AreaM2)}} m²</span>
              </div>
            {{end}}
            {{if .Listing.ConstructionM2}}
              <div class="spec-item">
                <span class="spec-label">Construcción</span>
                <span class="spec-value">{{formatNumber (derefFloat .Listing.ConstructionM2)}} m²</span>
              </div>
            {{end}}
            <div class="spec-item">
              <span class="spec-label">Municipio</span>
              <span class="spec-value">{{.Listing.Municipality}}</span>
            </div>
          </div>
        </section>
      </main>

      <!-- Sidebar -->
      <aside class="listing-sidebar">
        <div class="sidebar-sticky">
          <!-- Price Card -->
          <div class="sidebar-card price-card">
            <div class="price-label">Precio</div>
            <div class="price-main">{{formatMXN .Listing.PriceMXN}}</div>
            <div class="price-sub">{{convertToUSD .Listing.PriceMXN}}</div>
          </div>

          <!-- Owner Card -->
          <div class="sidebar-card owner-card">
            <div class="owner-header">
              {{if .Owner.AvatarURL}}
                <img src="{{derefString .Owner.AvatarURL}}" alt="{{.Owner.DisplayNameOrFull}}" class="owner-avatar">
              {{else}}
                <div class="owner-avatar owner-avatar-fallback">
                  {{slice .Owner.DisplayNameOrFull 0 1}}
                </div>
              {{end}}
              <div class="owner-meta">
                <h3 class="owner-name">
                  <a href="/usuarios/{{.Owner.ID}}">{{.Owner.DisplayNameOrFull}}</a>
                </h3>
                {{if .Owner.AgencyName}}
                  <span class="owner-role">{{derefString .Owner.AgencyName}}</span>
                {{else}}
                  <span class="owner-role">Vendedor particular</span>
                {{end}}
              </div>
            </div>

            <a href="/usuarios/{{.Owner.ID}}" class="btn-outline btn-block">
              Ver perfil
            </a>

            <div class="owner-divider"></div>

            {{if .User}}
              <!-- Contact Methods (authenticated) -->
              <div class="contact-methods">
                <h4 class="contact-heading">Contactar</h4>

                {{if and .Owner.ShowWhatsApp .Owner.WhatsApp}}
                  <a href="https://wa.me/{{derefString .Owner.WhatsApp}}?text=Hola,%20me%20interesa%20la%20propiedad:%20{{.Listing.Title}}" target="_blank" rel="noopener noreferrer" class="btn-whatsapp btn-block">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2zm5.79 14.07c-.24.68-1.4 1.29-1.92 1.37-.5.08-1.15.11-3.66-.92-3.21-1.33-5.27-4.57-5.43-4.78-.16-.21-1.3-1.73-1.3-3.3 0-1.57.82-2.34 1.11-2.66.29-.32.63-.4.84-.4.21 0 .42.01.6.01.19.01.44-.07.69.52.26.59.88 2.15.96 2.31.08.16.13.35.03.56-.11.21-.16.35-.32.53-.16.19-.34.42-.48.56-.16.16-.33.33-.14.65.19.32.84 1.38 1.8 2.24 1.24 1.1 2.28 1.45 2.6 1.61.32.16.51.14.7-.08.19-.22.82-.96 1.04-1.29.22-.33.45-.27.75-.16.3.11 1.91.9 2.24 1.06.33.16.55.24.63.38.08.14.08.82-.16 1.5z"/>
                    </svg>
                    WhatsApp
                  </a>
                {{end}}

                {{if and .Owner.ShowPhone .Owner.Phone}}
                  <a href="tel:{{derefString .Owner.Phone}}" class="btn-secondary btn-block">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                    </svg>
                    Llamar
                  </a>
                {{end}}

                {{if not (or .Owner.ShowPhone .Owner.ShowWhatsApp)}}
                  <p class="contact-notice">Este vendedor no ha habilitado contacto directo.</p>
                {{end}}
              </div>
            {{else}}
              <!-- Auth Gate -->
              <div class="auth-gate">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                <h4 class="auth-gate-title">Inicia sesión para contactar</h4>
                <p class="auth-gate-text">Protegemos a vendedores y compradores con cuentas verificadas.</p>
                <a href="/login?redirect=/propiedades/{{.Listing.Slug}}" class="btn-primary btn-block">
                  Iniciar sesión
                </a>
                <a href="/registro" class="auth-gate-link">¿No tienes cuenta? Regístrate</a>
              </div>
            {{end}}
          </div>
        </div>
      </aside>
    </div>
  </div>
</div>
{{end}}
