{{define "content"}}
<div class="container py-4">
    <!-- Breadcrumbs -->
    <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol class="d-flex gap-1 flex-wrap">
            <li><a href="/">Inicio</a></li>
            <li class="separator">/</li>
            <li><a href="/propiedades">Propiedades</a></li>
            <li class="separator">/</li>
            <li aria-current="page" class="active">{{.Listing.Title}}</li>
        </ol>
    </nav>

    <main class="detail-grid mt-3">
        <!-- Left Column: Content -->
        <article class="listing-detail">
            <!-- Gallery -->
            <div class="listing-gallery">
                {{if .Listing.Media}}
                    {{range .Listing.Media}}
                        <img src="{{.URL}}" alt="Foto de {{$.Listing.Title}}" class="listing-gallery-img" loading="lazy">
                    {{end}}
                {{else}}
                    <div class="listing-gallery-empty">
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                            <circle cx="8.5" cy="8.5" r="1.5"></circle>
                            <polyline points="21 15 16 10 5 21"></polyline>
                        </svg>
                        <span>Sin imágenes disponibles</span>
                    </div>
                {{endif}}
            </div>

            <!-- Header -->
            <header class="listing-header">
                <div class="listing-header-top">
                    <span class="badge badge-{{.Listing.Type}}">{{.Listing.GetFormattedType}}</span>
                    <span class="status status-{{.Listing.Status}}">{{.Listing.GetFormattedStatus}}</span>
                </div>
                <h1>{{.Listing.Title}}</h1>
                <div class="listing-location">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                        <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                    <span>{{.Listing.Municipality}}, Oaxaca</span>
                </div>
            </header>

            <!-- Price & Key Details Box -->
            <div class="listing-price-card">
                <div class="listing-price-main">
                    {{if eq .Listing.Currency "MXN"}}
                        {{formatMXN .Listing.Price}} <span class="listing-price-currency">MXN</span>
                        <div class="listing-price-usd">≈ {{formatUSD (convertToUSD .Listing.Price)}} USD</div>
                    {{else}}
                        {{formatUSD .Listing.Price}} <span class="listing-price-currency">USD</span>
                    {{end}}
                </div>
                <div class="listing-price-note">Trato Directo • Sin intermediarios</div>
            </div>

            <!-- Attributes Grid -->
            <div class="listing-details-grid">
                <div class="listing-detail-item">
                    <div class="listing-detail-label">Área total</div>
                    <div class="listing-detail-value">{{.Listing.AreaSqM}} m²</div>
                </div>
                <div class="listing-detail-item">
                    <div class="listing-detail-label">Tenencia</div>
                    <div class="listing-detail-value">{{.Listing.GetFormattedTenure}}</div>
                </div>
            </div>

            <!-- Description -->
            {{if .Listing.Description}}
            <section class="listing-description">
                <h2>Descripción de la propiedad</h2>
                <div class="listing-description-body">
                    <p>{{.Listing.Description}}</p>
                </div>
            </section>
            {{end}}
        </article>

        <!-- Right Column: Contact Card Widget (Securely Gated) -->
        <aside class="listing-sidebar">
            <div class="listing-contact">
					  <!-- Seller mini storefront card -->
                <div class="seller-profile-card mb-4">
                    <div class="seller-avatar-container">
                        {{if .Owner.AvatarURL}}
                            <img src="{{.Owner.AvatarURL}}" alt="{{.Owner.DisplayNameOrFull}}" class="seller-avatar">
                        {{else}}
                            <span class="seller-avatar-initial">{{.Owner.InitialLetter}}</span>
                        {{end}}
                    </div>
                    <div class="seller-details">
                        <span class="seller-label">Vendedor Autorizado</span>
                        <h3 class="seller-name">
                            <a href="/usuarios/{{.Owner.ID}}">{{.Owner.DisplayNameOrFull}}</a>
                        </h3>
                        {{if .Owner.AgencyName}}
                            <span class="seller-agency">🏢 {{.Owner.AgencyName}}</span>
                        {{end}}
                        <a href="/usuarios/{{.Owner.ID}}" class="seller-view-profile">Ver perfil completo →</a>
                    </div>
                </div>
                                        <!-- Direct Email Connection -->
                        <a href="mailto:{{.Owner.Email}}?subject=Interés en propiedad: {{.Listing.Title}}" class="btn btn-outline btn-block">
                            ✉️ Contactar por Correo
                        </a>

                        <!-- Direct WhatsApp (Gated by Owner's Visibility preference & Value existence) -->
                        {{if and .Owner.ShowWhatsApp .Owner.WhatsApp}}
                            <a href="https://wa.me/{{.Owner.WhatsApp}}?text=Hola,%20me%20interesa%20la%20propiedad%20que%20publicaste:%20{{.Listing.Title}}" target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp btn-block mt-2">
                                📱 Contactar por WhatsApp
                            </a>
                        {{end}}

                        <!-- Phone Call Connection (Gated by Owner's Visibility preference & Value existence) -->
                        {{if and .Owner.ShowPhone .Owner.Phone}}
                            <a href="tel:{{.Owner.Phone}}" class="btn btn-outline btn-block mt-2">
                                📞 Llamar al Propietario
                            </a>
                        {{end}}
                    </div>
                {{else}}
                    <h2>¿Te interesa esta propiedad?</h2>
                    <p class="text-muted font-sm">Debes iniciar sesión para poder ver los datos de contacto del propietario.</p>
                    <div class="contact-auth-gates mt-3">
                        <a href="/login?redirect=/propiedades/{{.Listing.Slug}}" class="btn btn-primary btn-block">
                            Iniciar Sesión
                        </a>
                        <a href="/registro" class="btn btn-outline btn-block mt-2">
                            Crear una Cuenta
                        </a>
                    </div>
                {{end}}
            </div>
        </aside>
    </main>
</div>
{{end}}
