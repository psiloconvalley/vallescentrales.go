{{define "title"}}Paso 3 de 3: Fotos | Valles Centrales{{end}}

{{define "content"}}
<div class="wizard-card">
    <div class="wizard-progress">
        <div class="wizard-progress-bar step-3-of-3"></div>
    </div>

    <div class="wizard-header-block">
        <span class="wizard-step-badge">Paso 3 de 3</span>
        <h1 class="wizard-title">Agrega fotos</h1>
        <p class="wizard-subtitle">Las propiedades con buenas fotos reciben 10 veces más contactos. Sube hasta 10 imágenes. La primera será la portada.</p>
    </div>

    <form method="POST" action="/publicar/paso/3" class="wizard-form" enctype="multipart/form-data" data-wizard-form>
        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">

        <!-- Dropzone -->
        <div class="wizard-dropzone" data-dropzone>
            <div class="wizard-dropzone-content">
                <div class="wizard-dropzone-icon">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                        <circle cx="8.5" cy="8.5" r="1.5"></circle>
                        <polyline points="21 15 16 10 5 21"></polyline>
                    </svg>
                </div>
                <p class="wizard-dropzone-title">Arrastra tus fotos aquí</p>
                <p class="wizard-dropzone-subtitle">o haz clic para seleccionar archivos</p>
                <p class="wizard-dropzone-hint">JPG, PNG o WebP · hasta 10 MB cada una · máximo 10 fotos</p>
            </div>
            <input type="file" id="images" name="images" accept="image/jpeg,image/png,image/webp" multiple class="wizard-dropzone-input">
        </div>

        <!-- Preview grid populated by wizard-photos.js -->
        <div class="wizard-preview-grid" data-preview-grid></div>

        <div class="wizard-actions">
            <a href="/publicar/paso/2" class="wizard-btn wizard-btn-secondary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
                <span>Atrás</span>
            </a>
            <div class="wizard-actions-right">
                <button type="submit" class="wizard-btn wizard-btn-primary wizard-btn-lg">
                    <span>Publicar propiedad</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                </button>
            </div>
        </div>
    </form>
</div>

<script src="/static/js/wizard-photos.js" defer></script>
{{end}}
