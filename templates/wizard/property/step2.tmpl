{{define "title"}}Paso 2 de 3: Detalles | Valles Centrales{{end}}

{{define "content"}}
<div class="wizard-card">
    <div class="wizard-progress">
        <div class="wizard-progress-bar step-2-of-3"></div>
    </div>

    <div class="wizard-header-block">
        <span class="wizard-step-badge">Paso 2 de 3</span>
        <h1 class="wizard-title">Detalles</h1>
        <p class="wizard-subtitle">Ubicación, precio y lo que necesitan saber los interesados.</p>
    </div>

    <form method="POST" action="/publicar/paso/2" class="wizard-form" data-wizard-form data-autosave-url="/publicar/auto-save">
        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">

        <!-- Title -->
        <div class="wizard-field">
            <label for="title" class="wizard-label">Título del anuncio</label>
            <input type="text" id="title" name="title" class="wizard-input"
                placeholder="Ej. Casa amplia con jardín en San Felipe del Agua"
                value="{{index .StepData "title"}}"
                required minlength="5" maxlength="200">
            <span class="wizard-help">Sé claro y específico. Esto es lo primero que ven.</span>
        </div>

        <!-- Description -->
        <div class="wizard-field">
            <label for="description" class="wizard-label">Descripción</label>
            <textarea id="description" name="description" class="wizard-input wizard-textarea"
                placeholder="Describe la propiedad: servicios (agua, luz, drenaje), accesos, acabados..."
                required minlength="20" rows="5">{{index .StepData "description"}}</textarea>
            <span class="wizard-help">Entre más detalle, más confianza generas.</span>
        </div>

        <!-- Municipality -->
        <div class="wizard-field">
            <label for="municipality" class="wizard-label">Municipio</label>
            <select id="municipality" name="municipality" class="wizard-select" required>
                <option value="">Elige tu municipio...</option>
                {{$current := index .StepData "municipality"}}
                {{range .Municipalities}}
                    <option value="{{.}}" {{if eq $current .}}selected{{end}}>{{.}}</option>
                {{end}}
            </select>
        </div>

        <!-- Community -->
        <div class="wizard-field">
            <label for="community" class="wizard-label">Colonia o localidad</label>
            <input type="text" id="community" name="community" class="wizard-input"
                placeholder="Ej. Barrio del Ex-Marquesado"
                value="{{index .StepData "community"}}">
            <span class="wizard-help">Opcional. Ayuda a los compradores a ubicarla rápido.</span>
        </div>

        <!-- Price -->
        <div class="wizard-field">
            <label for="price" class="wizard-label">Precio en pesos</label>
            <input type="number" id="price" name="price" class="wizard-input"
                placeholder="1,500,000"
                value="{{index .StepData "price"}}"
                required min="1" step="any">
            <span class="wizard-help">Solo números. Sin comas ni símbolos.</span>
        </div>

        <!-- Dimensions Row -->
        <div class="wizard-row">
            <div class="wizard-col">
                <div class="wizard-field">
                    <label for="lot_size_m2" class="wizard-label">Terreno (m²)</label>
                    <input type="number" id="lot_size_m2" name="lot_size_m2" class="wizard-input"
                        placeholder="300"
                        value="{{index .StepData "lot_size_m2"}}"
                        min="0" step="any">
                </div>
            </div>
            <div class="wizard-col">
                <div class="wizard-field">
                    <label for="construction_m2" class="wizard-label">Construcción (m²)</label>
                    <input type="number" id="construction_m2" name="construction_m2" class="wizard-input"
                        placeholder="150"
                        value="{{index .StepData "construction_m2"}}"
                        min="0" step="any">
                </div>
            </div>
        </div>

        <div class="wizard-actions">
            <a href="/publicar/paso/1" class="wizard-btn wizard-btn-secondary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
                <span>Atrás</span>
            </a>
            <div class="wizard-actions-right">
                <button type="submit" class="wizard-btn wizard-btn-primary wizard-btn-lg">
                    <span>Siguiente</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                </button>
            </div>
        </div>
    </form>
</div>
{{end}}
