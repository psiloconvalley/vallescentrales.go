{{define "wizard/base"}}<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{template "title" .}} — Valles Centrales</title>
    <!-- Load design tokens, resets, utilities and wizard css in sequence -->
    <link rel="stylesheet" href="/static/css/tokens.css?v={{.AssetVersion}}">
    <link rel="stylesheet" href="/static/css/reset.css?v={{.AssetVersion}}">
    <link rel="stylesheet" href="/static/css/fonts.css?v={{.AssetVersion}}">
    <link rel="stylesheet" href="/static/css/utilities.css?v={{.AssetVersion}}">
    <link rel="stylesheet" href="/static/css/wizard.css?v={{.AssetVersion}}">
</head>
<body class="wizard-body">
    <header class="wizard-header">
        <div class="container wizard-header-inner">
            <a href="/" class="brand-logo" aria-label="Valles Centrales">
                <span class="brand-text">Valles Centrales</span>
            </a>
            <a href="/" class="wizard-exit-btn">Salir</a>
        </div>
    </header>

    <main class="wizard-main">
        <div class="container wizard-container">
            {{template "content" .}}
        </div>
    </main>
</body>
</html>
{{end}}
