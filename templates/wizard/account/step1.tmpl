{{define "title"}}Paso 1 de 2 | Valles Centrales{{end}}

{{define "content"}}
<div class="wizard-card">
    <div class="wizard-progress">
        <div class="wizard-progress-bar step-1-of-2"></div>
    </div>

    <div class="wizard-header-block">
        <span class="wizard-step-badge">Paso 1 de 2</span>
        <h1 class="wizard-title">¿Qué vienes a hacer aquí?</h1>
        <p class="wizard-subtitle">Cuéntanos para mostrarte lo que necesitas.</p>
    </div>

    <form method="POST" action="/bienvenido/paso/1" class="wizard-form" id="wizard-form">
        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">

        <div class="wizard-options-grid">
            <!-- Option 1: Owner -->
            <label class="wizard-option-card">
                <input type="radio" name="user_type" value="owner" {{if eq (index .StepData "user_type") "owner"}}checked{{end}} required class="wizard-radio">
                <div class="wizard-option-content">
                    <div class="wizard-option-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                            <polyline points="9 22 9 12 15 12 15 22"></polyline>
                        </svg>
                    </div>
                    <div class="wizard-option-text">
                        <h3 class="wizard-option-title">Soy dueño</h3>
                        <p class="wizard-option-desc">Quiero vender o rentar mi casa, terreno o local.</p>
                    </div>
                </div>
            </label>

            <!-- Option 2: Agent / Agency -->
            <label class="wizard-option-card">
                <input type="radio" name="user_type" value="agent" {{if eq (index .StepData "user_type") "agent"}}checked{{end}} required class="wizard-radio">
                <div class="wizard-option-content">
                    <div class="wizard-option-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                        </svg>
                    </div>
                    <div class="wizard-option-text">
                        <h3 class="wizard-option-title">Soy inmobiliaria</h3>
                        <p class="wizard-option-desc">Trabajo con varias propiedades y clientes.</p>
                    </div>
                </div>
            </label>

            <!-- Option 3: Seeker -->
            <label class="wizard-option-card">
                <input type="radio" name="user_type" value="seeker" {{if eq (index .StepData "user_type") "seeker"}}checked{{end}} required class="wizard-radio">
                <div class="wizard-option-content">
                    <div class="wizard-option-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                    </div>
                    <div class="wizard-option-text">
                        <h3 class="wizard-option-title">Busco propiedad</h3>
                        <p class="wizard-option-desc">Quiero comprar o rentar algo en Oaxaca.</p>
                    </div>
                </div>
            </label>
        </div>

        <div class="wizard-actions">
            <div class="wizard-actions-right">
                <button type="submit" class="wizard-btn wizard-btn-primary wizard-btn-lg">
                    <span>Siguiente</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                </button>
            </div>
        </div>
    </form>
</div>
{{end}}
