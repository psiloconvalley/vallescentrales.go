{{define "title"}}Bienvenido — Paso 1 de 2{{end}}

{{define "content"}}
<div class="wizard-card">
    <div class="wizard-progress">
        <div class="wizard-progress-bar step-1-of-2"></div>
    </div>
    
    <div class="wizard-header-block">
        <span class="wizard-step-badge">Paso 1 de 2</span>
        <h1 class="wizard-title">¿Cómo planeas usar Valles Centrales?</h1>
        <p class="wizard-subtitle">Personalizaremos tu experiencia según tus necesidades en la región de Oaxaca.</p>
    </div>

    <form method="POST" action="/bienvenido/paso/1" class="wizard-form">
        <div class="wizard-options-grid">
            <label class="wizard-option-card">
                <input type="radio" name="user_type" value="buyer" class="wizard-radio" required {{if eq .UserType "buyer"}}checked{{end}}>
                <div class="wizard-option-content">
                    <div class="wizard-option-icon">🔍</div>
                    <div class="wizard-option-text">
                        <h3 class="wizard-option-title">Comprador / Inversionista</h3>
                        <p class="wizard-option-desc">Busco comprar o rentar casas, departamentos o terrenos en Valles Centrales.</p>
                    </div>
                </div>
            </label>

            <label class="wizard-option-card">
                <input type="radio" name="user_type" value="owner" class="wizard-radio" {{if eq .UserType "owner"}}checked{{end}}>
                <div class="wizard-option-content">
                    <div class="wizard-option-icon">🏡</div>
                    <div class="wizard-option-text">
                        <h3 class="wizard-option-title">Propietario Particular</h3>
                        <p class="wizard-option-desc">Deseo publicar y promocionar mis propiedades directamente sin intermediarios.</p>
                    </div>
                </div>
            </label>

            <label class="wizard-option-card">
                <input type="radio" name="user_type" value="agent" class="wizard-radio" {{if eq .UserType "agent"}}checked{{end}}>
                <div class="wizard-option-content">
                    <div class="wizard-option-icon">💼</div>
                    <div class="wizard-option-text">
                        <h3 class="wizard-option-title">Asesor Inmobiliario</h3>
                        <p class="wizard-option-desc">Soy profesional independiente administrando inventario en Oaxaca.</p>
                    </div>
                </div>
            </label>

            <label class="wizard-option-card">
                <input type="radio" name="user_type" value="agency" class="wizard-radio" {{if eq .UserType "agency"}}checked{{end}}>
                <div class="wizard-option-content">
                    <div class="wizard-option-icon">🏢</div>
                    <div class="wizard-option-text">
                        <h3 class="wizard-option-title">Agencia Inmobiliaria</h3>
                        <p class="wizard-option-desc">Represento una inmobiliaria o desarrolladora con equipo de ventas.</p>
                    </div>
                </div>
            </label>
        </div>

        <div class="wizard-actions">
            <button type="submit" class="btn btn-primary btn-lg">Continuar al Paso 2 &rarr;</button>
        </div>
    </form>
</div>
{{end}}
