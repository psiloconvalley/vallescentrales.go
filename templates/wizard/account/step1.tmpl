{{define "wizard-step"}}
<h1 class="wizard-step-heading">Bienvenido a Valles Centrales</h1>
<p class="wizard-step-description">Vamos a configurar tu cuenta en 2 pasos rápidos. Primero, cuéntanos quién eres.</p>

<form method="POST" action="/bienvenido/paso/1" data-wizard-form data-autosave-url="/bienvenido/auto-save" novalidate>
    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">

    <div class="wizard-field">
        <label class="wizard-label" for="full_name">Nombre completo *</label>
        <input class="wizard-input" type="text" id="full_name" name="full_name"
               value="{{index .Data "full_name"}}"
               required autocomplete="name" minlength="2"
               placeholder="Ej. María López García">
        <span class="wizard-help">Tu nombre tal como aparece en tus identificaciones oficiales.</span>
    </div>

    <div class="wizard-field">
        <label class="wizard-label" for="display_name">Nombre público o Alias</label>
        <input class="wizard-input" type="text" id="display_name" name="display_name"
               value="{{index .Data "display_name"}}"
               autocomplete="nickname"
               placeholder="Ej. María L. (así aparecerás en tus anuncios)">
        <span class="wizard-help">Cómo te verán los compradores. Puedes usar un nombre comercial o alias.</span>
    </div>

    <div class="wizard-field">
        <label class="wizard-label" for="user_type">¿Cuál es tu perfil?</label>
        <div class="wizard-choice-grid">
            <label class="wizard-choice-card">
                <input type="radio" name="user_type" value="particular"
                       {{if eq (index .Data "user_type") "particular"}}checked{{end}}
                       {{if not (index .Data "user_type")}}checked{{end}}>
                <span class="wizard-choice-icon">🏠</span>
                <span class="wizard-choice-label">Particular</span>
            </label>
            <label class="wizard-choice-card">
                <input type="radio" name="user_type" value="agente"
                       {{if eq (index .Data "user_type") "agente"}}checked{{end}}>
                <span class="wizard-choice-icon">💼</span>
                <span class="wizard-choice-label">Agente Inmobiliario</span>
            </label>
            <label class="wizard-choice-card">
                <input type="radio" name="user_type" value="inmobiliaria"
                       {{if eq (index .Data "user_type") "inmobiliaria"}}checked{{end}}>
                <span class="wizard-choice-icon">🏢</span>
                <span class="wizard-choice-label">Inmobiliaria</span>
            </label>
        </div>
    </div>

    <div class="wizard-nav">
        <span class="wizard-nav-spacer"></span>
        <button type="submit" class="wizard-btn wizard-btn-primary">Continuar →</button>
    </div>
</form>
{{end}}
