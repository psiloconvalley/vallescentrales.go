{{define "listing_card"}}
<article class="listing-card">
    <a href="/propiedades/{{.Slug}}" class="listing-card-media">
        {{if .PrimaryPhoto}}
            <img src="{{.PrimaryPhoto.URL}}" alt="{{.Title}}" class="listing-card-img" loading="lazy">
        {{else}}
            <div class="listing-card-placeholder">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                    <circle cx="8.5" cy="8.5" r="1.5"></circle>
                    <polyline points="21 15 16 10 5 21"></polyline>
                </svg>
            </div>
        {{end}}
        <div class="listing-card-badges">
            <span class="listing-card-badge listing-card-badge-op">{{operationLabel (printf "%s" .OperationType)}}</span>
            <span class="listing-card-badge listing-card-badge-type">{{propertyTypeLabel (printf "%s" .PropertyType)}}</span>
        </div>
    </a>
    <div class="listing-card-body">
        <h3 class="listing-card-title">
            <a href="/propiedades/{{.Slug}}">{{.Title}}</a>
        </h3>
        <p class="listing-card-location">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
            </svg>
            {{.Municipality}}
        </p>
        <div class="listing-card-footer">
            <span class="listing-card-price">{{formatMXN .PriceMXN}}</span>
            <span class="listing-card-price-sub">{{convertToUSD .PriceMXN}}</span>
        </div>
    </div>
</article>
{{end}}
