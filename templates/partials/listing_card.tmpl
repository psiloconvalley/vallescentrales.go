{{define "listing_card"}}
<article class="listing-card">
    <a href="/propiedades/{{.Slug}}">
        <div class="listing-card-image-wrap">
            {{if .PrimaryPhoto}}
                <img src="{{.PrimaryPhoto.URL}}" alt="{{.Title}}" class="listing-card-img" loading="lazy">
            {{else}}
                <div class="listing-card-placeholder">🏡</div>
            {{end}}
            <span class="listing-card-badge">{{.PropertyType}}</span>
        </div>
    </a>
    <div class="listing-card-content">
        <div class="listing-card-header">
            <h3 class="listing-card-title">
                <a href="/propiedades/{{.Slug}}">{{.Title}}</a>
            </h3>
            <p class="listing-card-location text-muted">📍 {{.Municipality}}</p>
        </div>
        <div class="listing-card-footer mt-auto">
            <span class="listing-card-price">{{formatMXN .PriceMXN}}</span>
            <span class="listing-card-price-usd text-muted">({{formatUSD (convertToUSD .PriceMXN)}} USD)</span>
        </div>
    </div>
</article>
{{end}}
