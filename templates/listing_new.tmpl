{{define "content"}}
<div class="container py-4">
    <header class="form-header">
        <h1>Publicar Nueva Propiedad</h1>
        <p class="text-muted">Completa los datos obligatorios para comenzar tu publicación en borrador</p>
    </header>

    {{if .Error}}
    <div class="flash flash-error mt-3">{{.Error}}</div>
    {{end}}

    <form method="POST" action="/publicar" class="mt-4" novalidate>
        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">

        <div class="form-group">
            <label class="form-label" for="title">Título de la Publicación</label>
            <input class="form-input" type="text" id="title" name="title" required value="{{if .FormData}}{{.FormData.Title}}{{end}}" placeholder="Ej: Amplio terreno plano en Santa María del Tule">
        </div>

        <div class="form-row mt-3">
            <div class="form-group col-6">
                <label class="form-label" for="property_type">Tipo de Propiedad</label>
                <select class="form-input" id="property_type" name="property_type" required>
                    <option value="land">Terreno</option>
                    <option value="house">Casa</option>
                    <option value="rancho">Rancho</option>
                    <option value="commercial">Local Comercial</option>
                    <option value="cabin">Cabaña</option>
                </select>
            </div>
            <div class="form-group col-6">
                <label class="form-label" for="price_mxn">Precio (MXN)</label>
                <input class="form-input" type="number" id="price_mxn" name="price_mxn" required value="{{if .FormData}}{{.FormData.PriceMXN}}{{end}}" placeholder="0.00">
            </div>
        </div>

        <div class="form-row mt-3">
            <div class="form-group col-6">
                <label class="form-label" for="municipality">Municipio de Oaxaca</label>
                <select class="form-input" id="municipality" name="municipality" required>
                    <option value="">Selecciona Municipio</option>
                    {{range $region, $munis := .Municipalities}}
                        <optgroup label="{{$region}}">
                            {{range $munis}}
                                <option value="{{.}}">{{.}}</option>
                            {{end}}
                        </optgroup>
                    {{end}}
                </select>
            </div>
            <div class="form-group col-6">
                <label class="form-label" for="community">Localidad o Colonia (Opcional)</label>
                <input class="form-input" type="text" id="community" name="community" value="{{if .FormData}}{{.FormData.Community}}{{end}}" placeholder="Ej: Centro, Barrio de la Asunción">
            </div>
        </div>

        <div class="form-group mt-3">
            <label class="form-label" for="description">Descripción Detallada</label>
            <textarea class="form-input" id="description" name="description" rows="5" placeholder="Describe los detalles, servicios disponibles (agua, luz, drenaje), accesos y ventajas de la propiedad...">{{if .FormData}}{{.FormData.Description}}{{end}}</textarea>
        </div>

        <div class="form-row mt-3">
            <div class="form-group col-6">
                <label class="form-label" for="area_m2">Superficie Terreno (M² - Opcional)</label>
                <input class="form-input" type="number" id="area_m2" name="area_m2" value="{{if .FormData}}{{.FormData.AreaM2}}{{end}}" placeholder="0">
            </div>
            <div class="form-group col-6">
                <label class="form-label" for="construction_m2">Superficie Construcción (M² - Opcional)</label>
                <input class="form-input" type="number" id="construction_m2" name="construction_m2" value="{{if .FormData}}{{.FormData.ConstructionM2}}{{end}}" placeholder="0">
            </div>
        </div>

        <div class="form-actions mt-4">
            <button type="submit" class="btn btn-primary">Crear Borrador</button>
            <a href="/cuenta" class="btn btn-secondary">Cancelar</a>
        </div>
    </form>
</div>
{{end}}
