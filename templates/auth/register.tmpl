{{define "content"}}
<div class="auth-container">
    <h1>Crear Cuenta</h1>

    {{if .Error}}
    <div class="flash flash-error">{{.Error}}</div>
    {{end}}

    <form method="POST" action="/registro" autocomplete="on" novalidate>
        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">

        <div class="form-group">
            <label class="form-label" for="fullName">Nombre Completo</label>
            <input class="form-input" type="text" id="fullName" name="fullName"
                   value="{{if .FormData}}{{.FormData.FullName}}{{end}}"
                   required autocomplete="name" placeholder="Tu nombre y apellido">
        </div>

        <div class="form-group mt-3">
            <label class="form-label" for="email">Correo Electrónico</label>
            <input class="form-input" type="email" id="email" name="email"
                   value="{{if .FormData}}{{.FormData.Email}}{{end}}"
                   required autocomplete="email" placeholder="tu@correo.com">
        </div>

        <div class="form-group mt-3">
            <label class="form-label" for="password">Contraseña</label>
            <div class="form-input-wrap">
                <input class="form-input" type="password" id="password" name="password"
                       required autocomplete="new-password"
                       placeholder="Mínimo 8 caracteres">
                <span class="password-toggle" id="passwordToggle" role="button" tabindex="0" aria-label="Mostrar contraseña"></span>
            </div>
        </div>

        <button type="submit" class="btn btn-primary btn-block mt-4">Crear Cuenta</button>
    </form>

    <div class="auth-footer">
        ¿Ya tienes cuenta? <a href="/login">Ingresar</a>
    </div>
</div>
{{end}}
