{{define "content"}}
<div class="container py-4">
    <header class="profile-header">
        <h1>Configuración de Cuenta</h1>
        <p class="text-muted">Administra tu información de perfil público y preferencias de contacto</p>
    </header>

    <div class="profile-layout mt-4">
        <!-- Settings Tabs -->
        {{template "settings_tabs" .}}

        <div class="profile-workspace card p-4 mt-3">
            <h2 class="section-title">Foto de Perfil</h2>
            <form method="POST" action="/api/upload/avatar" enctype="multipart/form-data" class="mt-3" novalidate>
                <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
                <div class="form-group">
                    <input type="file" name="avatar" class="form-input" accept="image/*">
                </div>
                <button type="submit" class="btn btn-primary btn-sm mt-2">Subir Avatar</button>
            </form>

            <h2 class="section-title mt-5">Información Personal</h2>
            <form method="POST" action="/cuenta/perfil" class="mt-3" novalidate>
                <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
                
                <div class="form-group">
                    <label class="form-label" for="full_name">Nombre Completo</label>
                    <input class="form-input" type="text" id="full_name" name="full_name" required value="{{.User.FullName}}">
                </div>

                <div class="form-row mt-3">
                    <div class="form-group col-6">
                        <label class="form-label" for="phone">Teléfono de Contacto</label>
                        <input class="form-input" type="tel" id="phone" name="phone" value="{{if .User.Phone}}{{.User.Phone}}{{end}}" placeholder="+52 951 123 4567">
                    </div>
                    <div class="form-group col-6">
                        <label class="form-label" for="whatsapp">WhatsApp de Contacto</label>
                        <input class="form-input" type="tel" id="whatsapp" name="whatsapp" value="{{if .User.WhatsApp}}{{.User.WhatsApp}}{{end}}" placeholder="+52 951 123 4567">
                    </div>
                </div>

                <div class="form-row mt-3">
                    <div class="form-group col-6">
                        <label class="checkbox-container">
                            <input type="checkbox" name="show_phone" value="true" {{if .User.ShowPhone}}checked{{end}}> Exponer teléfono públicamente
                        </label>
                    </div>
                    <div class="form-group col-6">
                        <label class="checkbox-container">
                            <input type="checkbox" name="show_whatsapp" value="true" {{if .User.ShowWhatsApp}}checked{{end}}> Exponer WhatsApp públicamente
                        </label>
                    </div>
                </div>

                <div class="form-actions mt-4">
                    <button type="submit" class="btn btn-primary">Guardar Perfil</button>
                    <a href="/cuenta" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>
{{end}}
