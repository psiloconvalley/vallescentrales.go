{{define "content"}}
<div class="container py-4">
  <header class="profile-header">
    <h1>Configuración de Cuenta</h1>
    <p class="text-muted">Administra tu información de perfil público y preferencias de contacto</p>
  </header>

  <div class="profile-layout mt-4">
    <!-- Settings Tabs -->
    {{template "settings_tabs" .}}

    <div class="profile-workspace card p-4 mt-3">
      <!-- Status Alerts -->
      {{if .Error}}
        <div class="flash flash-error">{{.Error}}</div>
      {{end}}
      {{if .Success}}
        <div class="flash flash-success">{{.Success}}</div>
      {{end}}

      <!-- Profile Avatar Block -->
      <section class="settings-section">
        <h2 class="section-title">Foto de Perfil</h2>
        <div class="avatar-upload-block mt-3">
          <div class="avatar-preview-container">
            {{if .User.AvatarURL}}
              <img src="{{.User.AvatarURL}}" alt="{{.User.DisplayNameOrFull}}" class="profile-avatar-large">
            {{else}}
              <div class="profile-avatar-large profile-avatar-fallback">
                {{slice .User.DisplayNameOrFull 0 1}}
              </div>
            {{end}}
          </div>
          <form method="POST" action="/api/upload/avatar" enctype="multipart/form-data" class="avatar-upload-form" novalidate>
            <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
            <div class="form-group">
              <label class="form-label" for="avatar-file">Seleccionar nueva imagen</label>
              <input type="file" id="avatar-file" name="avatar" class="form-input" accept="image/jpeg,image/png,image/webp">
              <span class="form-help">Formatos aceptados: JPG, PNG o WebP. Máximo 5MB.</span>
            </div>
            <button type="submit" class="btn btn-secondary btn-sm mt-2">Subir Foto</button>
          </form>
        </div>
      </section>

      <hr class="settings-divider mt-4 mb-4">

      <!-- Settings Information Form -->
      <form method="POST" action="/cuenta/perfil" novalidate>
        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
        
        <!-- Public Profile Section -->
        <section class="settings-section">
          <h2 class="section-title">Perfil Público</h2>
          <p class="section-subtitle text-muted">Esta información es visible en tus publicaciones y en tu página de vendedor pública.</p>

          <div class="form-group mt-3">
            <label class="form-label" for="full_name">Nombre Completo (Obligatorio)</label>
            <input class="form-input" type="text" id="full_name" name="full_name" required value="{{.User.FullName}}">
          </div>

          <div class="form-row mt-3">
            <div class="form-group col-6">
              <label class="form-label" for="display_name">Nombre de Mostrar o Comercial</label>
              <input class="form-input" type="text" id="display_name" name="display_name" value="{{if .User.DisplayName}}{{.User.DisplayName}}{{end}}" placeholder="Ej: Inmobiliaria Oaxaca">
              <span class="form-help">Se usará en lugar de tu nombre completo si está definido.</span>
            </div>
            <div class="form-group col-6">
              <label class="form-label" for="username">Nombre de Usuario (Único)</label>
              <input class="form-input" type="text" id="username" name="username" value="{{if .User.Username}}{{.User.Username}}{{end}}" placeholder="ej_inmobiliaria">
              <span class="form-help">Solo letras, números y guion bajo. Mínimo 3 caracteres.</span>
            </div>
          </div>

          <div class="form-row mt-3">
            <div class="form-group col-6">
              <label class="form-label" for="agency_name">Nombre de la Agencia</label>
              <input class="form-input" type="text" id="agency_name" name="agency_name" value="{{if .User.AgencyName}}{{.User.AgencyName}}{{end}}" placeholder="Ej: Valles Centrales Bienes Raíces">
            </div>
            <div class="form-group col-6">
              <label class="form-label" for="website">Sitio Web</label>
              <input class="form-input" type="url" id="website" name="website" value="{{if .User.Website}}{{.User.Website}}{{end}}" placeholder="https://tusitio.com">
            </div>
          </div>

          <div class="form-row mt-3">
            <div class="form-group col-12">
              <label class="form-label" for="location">Ubicación de Operación</label>
              <input class="form-input" type="text" id="location" name="location" value="{{if .User.Location}}{{.User.Location}}{{end}}" placeholder="Ej: San Felipe del Agua, Oaxaca">
            </div>
          </div>

          <div class="form-group mt-3">
            <label class="form-label" for="bio">Biografía / Acerca de ti</label>
            <textarea class="form-input form-textarea" id="bio" name="bio" rows="4" placeholder="Cuéntale a los interesados sobre tu trayectoria inmobiliaria o tu servicio...">{{if .User.Bio}}{{.User.Bio}}{{end}}</textarea>
            <span class="form-help">Máximo 160 caracteres.</span>
          </div>
        </section>

        <hr class="settings-divider mt-4 mb-4">

        <!-- Contact Methods Section -->
        <section class="settings-section">
          <h2 class="section-title">Métodos de Contacto Directo</h2>
          <p class="section-subtitle text-muted">Añade tus números para permitir contacto telefónico o por WhatsApp. Puedes ocultarlos o mostrarlos cuando quieras.</p>

          <div class="form-row mt-3">
            <div class="form-group col-6">
              <label class="form-label" for="phone">Teléfono de Contacto</label>
              <input class="form-input" type="tel" id="phone" name="phone" value="{{if .User.Phone}}{{.User.Phone}}{{end}}" placeholder="+52 951 123 4567">
            </div>
            <div class="form-group col-6">
              <label class="form-label" for="whatsapp">WhatsApp de Contacto</label>
              <input class="form-input" type="tel" id="whatsapp" name="whatsapp" value="{{if .User.WhatsApp}}{{.User.WhatsApp}}{{end}}" placeholder="+52 951 123 4567">
            </div>
          </div>

          <!-- Privacy Settings Switches -->
          <div class="form-row mt-4">
            <div class="form-group col-6">
              <label class="checkbox-container">
                <input type="checkbox" name="show_phone" {{if .User.ShowPhone}}checked{{end}}> 
                <span class="checkbox-label">Mostrar mi teléfono en mis anuncios</span>
              </label>
            </div>
            <div class="form-group col-6">
              <label class="checkbox-container">
                <input type="checkbox" name="show_whatsapp" {{if .User.ShowWhatsApp}}checked{{end}}> 
                <span class="checkbox-label">Mostrar mi WhatsApp en mis anuncios</span>
              </label>
            </div>
          </div>
        </section>

        <!-- Form Actions -->
        <div class="form-actions mt-5">
          <button type="submit" class="btn btn-primary">Guardar Perfil</button>
          <a href="/cuenta" class="btn btn-secondary">Volver al Panel</a>
        </div>
      </form>
    </div>
  </div>
</div>
{{end}}
