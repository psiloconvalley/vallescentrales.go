{{define "content"}}
<div class="container py-5">
    <div class="profile-header mb-5">
        <div class="profile-avatar">
            {{if .Profile.AvatarURL}}
                <img src="{{.Profile.AvatarURL}}" alt="{{.Profile.DisplayNameOrFull}}" class="avatar-cover">
            {{else}}
                {{.Profile.InitialLetter}}
            {{end}}
        </div>
        <div class="profile-info">
            <h1>{{.Profile.DisplayNameOrFull}}</h1>
            {{if .Profile.AgencyName}}
                <p class="text-muted font-semibold">🏢 {{.Profile.AgencyName}}</p>
            {{end}}
            
            {{if .Profile.Bio}}
                <p class="mt-2 text-muted max-w-prose font-italic">"{{.Profile.Bio}}"</p>
            {{end}}

            <div class="flex gap-2 flex-wrap mt-3 text-sm text-light">
                {{if .Profile.Location}}
                    <span>📍 {{.Profile.Location}}</span>
                {{end}}
                {{if .Profile.Website}}
                    <span>🌐 <a href="{{.Profile.Website}}" target="_blank" rel="noopener noreferrer" class="link-accent">{{.Profile.Website}}</a></span>
                {{end}}
            </div>
        </div>
    </div>

    <!-- Listings Section -->
    <h2 class="mb-4">Propiedades de {{.Profile.DisplayNameOrFull}}</h2>
    {{if .Listings}}
        <div class="listing-grid">
            {{range .Listings}}
                {{template "listing_card" .}}
            {{end}}
        </div>
    {{else}}
        <div class="empty-state text-center py-5">
            <h2>Sin propiedades activas</h2>
            <p class="text-muted">Este usuario no tiene propiedades publicadas en este momento.</p>
        </div>
    {{end}}
</div>
{{end}}
