{{define "content"}}
<div class="container py-4">
    <header class="dashboard-header d-flex justify-between align-center">
        <div>
            <h1>Mi Panel de Control</h1>
            <p class="text-muted">Administra tus publicaciones y datos de contacto en Valles Centrales</p>
        </div>
        <a href="/cuenta/perfil" class="btn btn-secondary btn-sm">Editar Perfil</a>
    </header>

    <div class="dashboard-content mt-4">
        <div class="dashboard-actions mb-3">
            <a href="/publicar" class="btn btn-primary">+ Publicar Propiedad</a>
        </div>

        {{if .Listings}}
        <div class="dashboard-list card">
            {{range .Listings}}
            <div class="dashboard-item d-flex justify-between align-center p-3">
                <div class="item-meta">
                    <h3>{{.Title}}</h3>
                    <p class="font-sm text-muted">📍 {{.Municipality}} • Estado: <strong>{{.Status}}</strong> • 👁️ {{.ViewCount}} vistas</p>
                </div>
                <div class="item-actions d-flex gap-2">
                    <a href="/propiedades/{{.Slug}}/editar" class="btn btn-outline btn-sm">Editar</a>
                    <a href="/propiedades/{{.Slug}}" class="btn btn-secondary btn-sm" target="_blank">Ver</a>
                </div>
            </div>
            {{end}}
        </div>
        {{else}}
        <div class="empty-state card p-5 text-center">
            <h2>Aún no tienes propiedades publicadas</h2>
            <p class="text-muted">Comienza publicando tu primer terreno, casa o local comercial hoy mismo.</p>
            <a href="/publicar" class="btn btn-primary mt-3">Publicar Ahora →</a>
        </div>
        {{end}}
    </div>
</div>
{{end}}
